# true  = the UI uses the fake data in src/mocks (no backend needed)
# false = the UI calls the real API at VITE_API_BASE_URL
VITE_USE_MOCKS=true

# Mocks only: false = see the dashboard as a regular user (no announcement editing)
VITE_MOCK_ADMIN=true

# Base path for all API calls. Keep "/api" when using the dev proxy below.
VITE_API_BASE_URL=/api

# Dev only: forward /api/* to the backend (e.g. http://localhost:8080). Leave empty to disable.
VITE_API_PROXY_TARGET=
